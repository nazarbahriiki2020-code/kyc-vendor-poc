# Copy to .env and fill in. .env is git-ignored: never commit real keys.

# --- Didit (use a SANDBOX-mode application for testing) -----------------
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
# Appears only after you add a webhook destination in the console
DIDIT_WEBHOOK_SECRET=
# DIDIT_BASE_URL=https://verification.didit.me

# --- Veriff (use a TEST integration) --------------------------------------
VERIFF_API_KEY=
VERIFF_SHARED_SECRET=
# Copy the Base URL shown on your integration page
VERIFF_BASE_URL=https://stationapi.veriff.com

# Where run logs and summary.md are written
RESULTS_DIR=results
